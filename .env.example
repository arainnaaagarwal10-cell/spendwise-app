# SpendWise — Environment Variables Template
# Copy this to .env for local development (never commit .env to GitHub)
# Set these in Vercel Dashboard → Project Settings → Environment Variables

# ─────────────────────────────────────────────────────────────────
# REQUIRED: Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Project Settings → Database → URI
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
